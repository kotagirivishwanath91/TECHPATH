# TechPath — Environment Variables Example
# Replace placeholders with your real credentials in your local .env file.
# NEVER commit .env to version control or expose secret keys to the browser.

# Supabase Project URL (Do not append /rest/v1/)
SUPABASE_URL=https://hcvgndaetfarwsbjxcog.supabase.co

# Client-safe Publishable / Anon Key (Used in browser Supabase client)
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key_here

# SERVER ONLY — Service Role / Secret Key (NEVER expose to browser)
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here

# SERVER ONLY — Google Gemini API Key (NEVER expose to browser)
GEMINI_API_KEY=your_gemini_api_key_here

# SERVER ONLY — YouTube Data API Key (Optional)
YOUTUBE_API_KEY=your_youtube_api_key_here
